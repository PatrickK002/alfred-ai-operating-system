# Copy to .env for local development. Never commit the real key.
NODE_ENV=development
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:4173
AUTHENTICATION_ENABLED=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
SEMANTIC_INDEXING_ENABLED=true

MONDAY_API_TOKEN=
MONDAY_FINANCE_BOARD_IDS=
MONDAY_API_VERSION=2025-04

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
VOICE_ENABLED=true
VOICE_TRANSCRIPT_LOGGING_ENABLED=true
VOICE_TRANSCRIPT_RETENTION_DAYS=30
VOICE_AI_TIMEOUT_MS=12000

# Existing optional local settings
PORT=4173
HOST=127.0.0.1
ENFORCE_HTTPS=true
