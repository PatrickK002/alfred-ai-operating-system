# Copy to .env for local development. Never commit real keys or tokens.
NODE_ENV=development
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:4173
AUTHENTICATION_ENABLED=false
ALFRED_DB_PATH=./data/alfred.db
ALFRED_BACKUP_STRATEGY=local-dev
ENFORCE_HTTPS=true

# Claude reasoning. Server-side only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Voyage semantic memory. Server-side only.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
SEMANTIC_INDEXING_ENABLED=true

# Microsoft 365 read-only OAuth configuration.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_TOKEN_PATH=./data/microsoft-token.json

# Monday.com read-only finance/operating intelligence.
MONDAY_API_TOKEN=
MONDAY_FINANCE_BOARD_IDS=
MONDAY_API_VERSION=2025-04

# Voice Command Centre providers. No raw audio is stored by default.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
VOICE_ENABLED=true
VOICE_TRANSCRIPT_LOGGING_ENABLED=true
VOICE_TRANSCRIPT_RETENTION_DAYS=30
VOICE_AI_TIMEOUT_MS=12000

# Existing optional local settings
PORT=4173
HOST=127.0.0.1
